<table class="table table-striped table-hover table-responsive">
    <tr>
        <th>Timestamp</th>
        <th>User</th>
        <th>Message</th>
    </tr>
{{ range . }}
    <tr>
        <td>{{ .Timestamp }}</td>
        <td>{{ .Name }}</td>
        <td>{{ .Message }}</td>
    <tr>
{{ end }}
</table>